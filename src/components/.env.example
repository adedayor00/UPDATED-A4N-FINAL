# Copy to .env for local development. With these blank, the site runs in
# demo mode (sample data kept in your browser; demo login shown on /login).

# Supabase → Project Settings → API. The anon key is safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional
# VITE_SITE_URL=https://apartments4newark.com
# VITE_PLAUSIBLE_DOMAIN=apartments4newark.com
# Google Street View photo of the building for listings with no photos.
# Google Cloud → enable "Street View Static API" → create an API key and
# restrict it to HTTP referrers apartments4newark.com/* and to that one API.
# VITE_GOOGLE_MAPS_KEY=
# VITE_GA_ID=G-XXXXXXXXXX
